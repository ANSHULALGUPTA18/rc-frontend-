# Copy this file to .env.local and fill in the values below.

# --- API mode -----------------------------------------------------------
# true  = use mock data baked into features/*/api/client.ts (no backend needed)
# false = call the real backend at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the backend API. Required when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_URL=

# --- Azure AD (Entra ID) SSO ---------------------------------------------
# Only required when NEXT_PUBLIC_USE_MOCK=false.
# Get these values from the Azure App Registration (Techgene tenant).
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000/login

# OAuth2 scope for the RC Pricing backend API (e.g. "api://<backend-client-id>/access_as_user").
# Leave empty until the backend's Azure App Registration exists — apiFetch()
# simply won't attach an Authorization header until this is set.
NEXT_PUBLIC_AZURE_API_SCOPE=
